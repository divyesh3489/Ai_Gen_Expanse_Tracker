# Local development environment
# Usage: cp dev.env .env   then fill in the <...> values
# Matches docker-compose.yml (web :8000, frontend :3000, postgres, redis)

SECRET_KEY=dev-insecure-secret-key-change-me
# Any non-empty value turns DEBUG on (Django then also serves /media/)
DEBUG=True

DOMAIN=http://localhost:8000
FRONTEND_URL=http://localhost:3000
FRONTEND_LOGIN_URL=http://localhost:3000/login
# Extra domains for ALLOWED_HOSTS / CORS / CSRF (not needed locally)
APP_DOMAINS=

# Database
# Any non-empty value uses Postgres; remove the line to use SQLite (db.sqlite3)
production=True
database=expanse_tracker_db
user_name=postgres
password=admin
# "postgres" inside Docker; use "localhost" when running Django outside Docker
host=postgres
port=5432

# Redis (use localhost instead of redis when running outside Docker)
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_URL=redis://redis:6379/1

# Email (Gmail SMTP: use an app password, not your normal password)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=<your gmail>
EMAIL_HOST_PASSWORD=<gmail app password>
